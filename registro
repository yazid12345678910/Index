<!DOCTYPE html>
<html dir="ltr">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="estilo_R.css">
  <title>Registro</title>
</head>

<body>
  <div class="wrapper">
    <h2>Registro</h2>
    <form action="registro.php" method="POST">
      <div class="input-box">
        <input type="text" name="nombre" placeholder="Introduce tu nombre" required>
      </div>
      <div class="input-box">
        <input type="email" name="correo" placeholder="Introduce tu correo" required>
      </div>
      <div class="input-box">
        <input type="password" name="contraseña" placeholder="Crea una contraseña" required>
      </div>
      <div class="input-box">
        <input type="password" name="confirmar_contraseña" placeholder="Confirma tu contraseña" required>
      </div>

      <div class="input-box button">
        <input type="submit" value="Registrarse">
      </div>

      <div class="text">
        <h3>¿Ya tienes una cuenta? <a href="index.html">Iniciar sesión</a></h3>
      </div>
    </form>
  </div>
</body>

</html>
